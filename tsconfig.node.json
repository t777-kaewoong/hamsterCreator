{
  // vite.config.ts 자체를 검사하기 위한 설정입니다 (Node 환경 기준).
  // 브라우저 코드(src/)의 타입 설정과는 분리되어 있습니다.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
