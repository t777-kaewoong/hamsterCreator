# 설치된 패키지 — package.json 만 있으면 npm install 로 다시 만들 수 있음
node_modules

# 빌드 산출물 — npm run build / build:single 로 다시 만들 수 있음
dist
dist-single

# tsc -b 가 남기는 빌드 캐시 (내용물이 아니라 캐시라서 커밋할 필요 없음)
*.tsbuildinfo

# OS·에디터가 알아서 만드는 파일들
.DS_Store
*.local
.vscode
.idea

# Claude Code 로컬 설정(개발 서버 실행 정보). 공유할 필요 없음
.claude/

# QA 산출물·브라우저 프로필 등 작업용 임시 폴더
tmp/

# 참고용 교과서 PDF(저작권 자료라 공개 저장소에 올리지 않음)
/*.pdf

# 로보메이션 공식 배포 PDF 원본(참고용 원자료).
# 앱이 실행 중에 쓰지 않습니다 — 여기서 추출해 둔 타일은 src/assets/tiles/ 에 있습니다.
# 저장소가 Public이라 원본 PDF 23종(4.6MB)을 통째로 올리면 그 자체가 재배포가 되므로
# 2026-09-16에 추적에서 뺐습니다. 파일은 디스크에 그대로 있으니 계속 열어 보면 됩니다.
# (docs/02 §0 전제 2 "자산 번들 가능"은 추출한 타일을 앱에 내장하는 것에 대한 결정이고,
#  원본 PDF를 저장소에 그대로 올리는 것과는 별개입니다.)
말판/

# 개인 작업 지시 메모
tokenSave.txt
