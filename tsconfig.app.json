{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    // 타입 검사를 엄격하게 켭니다. 빨간 줄이 뜨면 진짜 버그일 확률이 높습니다.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // import 할 때 "@/lib/model/..." 처럼 쓸 수 있게 하는 별칭 설정.
    // vite.config.ts 의 alias 설정과 항상 짝을 맞춰야 합니다.
    // manifest.json 처럼 JSON 파일을 import 할 수 있게 허용합니다(타일 카탈로그에서 사용)
    "resolveJsonModule": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
